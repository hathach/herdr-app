{
  "id": "root",
  "notice": "Modified from Herdr's main layout (Apache-2.0): the tab bar, agents list and the Files and Changes panels use my-tabs, my-agents, my-files and my-changes; Issues and PRs panels use my-github; the panel snaps.",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "my-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "resizable": false,
              "children": [
                {
                  "id": "panel-snap",
                  "type": "block",
                  "content": {
                    "mod": "my-panel-snap"
                  },
                  "size": {
                    "px": 0
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files",
                        "props": {
                          "code_font_size": 13
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "my-changes",
                        "props": {
                          "code_font_size": 13
                        }
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "my-github",
                        "props": {
                          "kind": "issues"
                        }
                      }
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "my-github",
                        "props": {
                          "kind": "prs"
                        }
                      }
                    },
                    {
                      "id": "git",
                      "type": "column",
                      "gap": 8,
                      "children": [
                        {
                          "id": "git-log",
                          "type": "block",
                          "size": {
                            "weight": 3
                          },
                          "content": {
                            "mod": "my-git"
                          }
                        },
                        {
                          "id": "git-changes",
                          "type": "block",
                          "size": {
                            "weight": 5
                          },
                          "content": {
                            "mod": "my-changes",
                            "props": {
                              "source": "git",
                              "panel": "git",
                              "code_font_size": 13
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "weight": 0.6
              },
              "min": 280,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
